{
  "manifest_version": 3,
  "name": "SRAP - Raw Realities",
  "version": "1.0.0",
  "description": "Existential self-assessment platform for the three centers: Head, Heart, and Body.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "og-image.svg"
  },
  "icons": {
    "512": "og-image.svg"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
